+            .putExtra("folder", folder.toString()).putExtra("voice", selectedVoice()?.voice?.name)
+            .putExtra("rate", (speed() * (selectedVoice()?.rateFactor ?: 1f)).coerceIn(0.1f, 2.0f))
+            .putExtra("pitch", (pitch() * (selectedVoice()?.pitchFactor ?: 1f)).coerceIn(0.5f, 2.0f))
             .putExtra("kbps", bitrates[spBitrate.selectedItemPosition])
             .putExtra("split", splits[spSplit.selectedItemPosition])
             .putExtra("pause", pauses[spPause.selectedItemPosition])
